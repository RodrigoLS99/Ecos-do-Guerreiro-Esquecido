[node name="StoryLabel" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/VBoxContainer"]
modulate = Color(0.92, 0.95, 1, 0.95)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Com o Artefato Sagrado em mãos e a Princesa libertada do ápice da Torre, a névoa de corrupção que assolava a terra começou a se dissipar das muralhas milenares.

Os ecos do passado, antes almas em tormento e solidão, agora descansam em paz, gravados como guardiões eternos nas crônicas do reino renascido.

Sua coragem e maestria sobre os ecos restauraram o equilíbrio da terra. A humanidade contempla uma nova aurora de esperança e harmonia."
horizontal_alignment = 1
autowrap_mode = 3

