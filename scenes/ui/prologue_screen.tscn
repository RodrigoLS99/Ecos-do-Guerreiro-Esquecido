[node name="StoryLabel" type="Label" parent="CenterContainer/Panel/MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.88, 0.92, 0.96, 0.95)
theme_override_constants/line_spacing = 8
theme_override_font_sizes/font_size = 16
text = "Há eras, o reino prosperava sob o brilho da Relíquia dos Ecos, guardada pela Princesa nas alturas do Templo Sagrado.

Porém, uma névoa espectral emergiu dos abismos, apagando as memórias de todos os povos e condenando a terra ao esquecimento.

A Princesa e a sagrada Relíquia foram aprisionadas no topo da torre por forças ancestrais corrompidas.

Você, o Guerreiro Esquecido, desperta. Domine os ecos do seu passado, desbrave as armadilhas dos cinco andares, recupere o artefato e liberte a Princesa!"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="ContinueButton" type="Button" parent="CenterContainer/Panel/MarginContainer/VBoxContainer"]
unique_name_in_owner = true
